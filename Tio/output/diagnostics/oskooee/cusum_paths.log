. tempname PATHS

. postfile `PATHS' str80 model_id double tq CUSUM cusum_lower cusum_upper cusum_expected official_stat using "$OP/output/diagnostics/oskooee/stata_cusum_paths.dta", replace

. foreach id of local models {
  2.     use `summaries', clear
  3.     keep if model_id=="`id'"
  4.     local sid=sid[1]
  5.     local estimator=estimator[1]
  6.     local expected_stat=cusum[1]
  7.     local expected_N=N[1]
  8.     estimates use "$OP/output/diagnostics/oskooee/models/`id'.ster"
  9.     local terms : colnames e(b)
 10.     local xx "yd yf q"
 11.     if "`estimator'"=="NARDL" local xx "yd yf pos neg"
 12.     local lags ""
 13.     foreach v in y `xx' {
 14.         local mx=0
 15.         foreach term of local terms {
 16.             if "`term'"=="L.`v'" local mx=max(`mx',1)
 17.             if regexm("`term'","^L([0-9]+)[.]`v'$") local mx=max(`mx',real(regexs(1)))
 18.         }
 19.         local lags "`lags' `mx'"
 20.     }
 21.     use "$OP/output/diagnostics/oskooee/models/`id'_design.dta", clear
 22.     quietly summarize tq
 23.     local first=r(min)
 24.     local last=r(max)
 25.     use "$OP/intermediate/oskooee/analysis_quarterly.dta", clear
 26.     keep if sid==`sid'
 27.     tsset tq
 28.     gen double dq=D.q
 29.     gen double pos=sum(cond(missing(dq),0,max(dq,0)))
 30.     gen double neg=sum(cond(missing(dq),0,min(dq,0)))
 31.     quietly ardl y `xx' if inrange(tq,`first',`last'), lags(`lags') ec1 regstore(uecm)
 32.     assert e(N)==`expected_N'
 33.     estimates restore uecm
 34.     local kk=e(rank)
 35.     gen byte es=e(sample)
 36.     quietly estat sbcusum, nograph generate(official, ci)
 37.     local official_stat=r(cusum)
 38.     assert abs(`official_stat'-`expected_stat')<1e-7
 39.     keep if es
 40.     gen double tau=(_n-`kk')/(_N-`kk')
 41.     forvalues i=1/`=_N' {
 42.         if !missing(official[`i']) post `PATHS' ("`id'") (tq[`i']) (official[`i']) (official_lb[`i']) (official_ub[`i']) (tau[`i']) (`official_stat')
 43.     }
 44. }
