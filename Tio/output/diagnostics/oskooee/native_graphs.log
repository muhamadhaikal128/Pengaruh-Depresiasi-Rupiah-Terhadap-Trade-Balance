> ed

. do "$OP/script/group_forests.do"

. * Seven overlapping groups; one editable forest per partner and estimator.
. import delimited "$OP/output/tables/oskooee/Forest_Goods_Data.csv", clear var
> names(1) case(preserve) encoding(utf8) asdouble
(11 vars, 154 obs)

. levelsof ISO3, local(partners)
`"AUS"' `"CHN"' `"IND"' `"JPN"' `"KOR"' `"MYS"' `"SGP"' `"THA"' `"USA"' `"VNM"'
>  `"WLD"'

. foreach iso of local partners {
  2.     foreach est in ARDL NARDL {
  3.         preserve
  4.         keep if ISO3=="`iso'" & estimator=="`est'"
  5.         gen byte axis=8-Order
  6.         label define goods_axis 7 "Non-komoditas (manufaktur)" 6 "Barang k
> onsumsi" 5 "Komoditas pertanian & pangan" 4 "Bahan baku/penolong" 3 "Barang m
> odal" 2 "Komoditas (total)" 1 "Komoditas energi & tambang", replace
  7.         label values axis goods_axis
  8.         local term "q"
  9.         if "`est'"=="NARDL" local term "NEG"
 10.         twoway (rcap Lo95 Hi95 axis, horizontal lcolor(gs9)) (scatter axis
>  Estimate if Supported==1 & Clean==1, msymbol(O) mcolor("165 100 78")) (scatt
> er axis Estimate if Supported==1 & Clean==0, msymbol(O) mcolor("193 117 41"))
>  (scatter axis Estimate if Supported==0, msymbol(Oh) mcolor(gs7)), xline(0,lc
> olor(maroon)) ylabel(1(1)7,valuelabel angle(0) labsize(small)) yscale(range(.
> 5 7.5)) ytitle("") xtitle("Koefisien jangka panjang `term' (CI nominal 95%)",
> size(small)) title("Efek jangka panjang per kelompok: `iso'") subtitle("`est'
>  | y = ln(M/X); q naik = apresiasi",size(small)) note("Positif: arah perbaika
> n neraca saat depresiasi. Kelompok saling tumpang tindih." "Koefisien tanpa d
> ukungan levels belum layak ditafsirkan sebagai hubungan LR mapan.",size(vsmal
> l)) legend(order(2 "Levels + diagnostik" 3 "Levels; caveat diagnostik" 4 "Lev
> els belum didukung") rows(1) size(vsmall)) graphregion(color(white)) plotregi
> on(color(white)) xsize(12) ysize(7) name(groupforest,replace) nodraw
 11.         graph save groupforest "$OP/output/gph/oskooee/forest_`iso'_`est'_
> goods.gph", replace
 12.         * PNG/PDF use the identical coefficient data through the reporting
>  script;
.         * batch Stata retains the native editable GPH without requiring a Gra
> ph window.
.         graph drop groupforest
 13.         restore
 14.     }
 15. }
