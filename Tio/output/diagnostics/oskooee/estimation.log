. do "$OP/script/03_ardl_agregat.do"

. use "$OP/intermediate/oskooee/analysis_quarterly.dta", clear

. levelsof sid if scope=="aggregate", local(sids)
1 2

. foreach s of local sids {
  2.     preserve
  3.     keep if sid==`s'
  4.     local scen=scenario[1]
  5.     restore
  6.     foreach estimator in ARDL NARDL {
  7.         noisily display "RUNNING SID `s': `estimator' AIC4"
  8.         capture noisily fitcase `s' `estimator' 4
  9.         if _rc post $PF ("SID`s'_`estimator'_4") ("unhandled") (_rc)
 10.         if "`scen'"=="main" {
 11.             noisily display "RUNNING SID `s': `estimator' AIC2"
 12.             capture noisily fitcase `s' `estimator' 2
 13.             if _rc post $PF ("SID`s'_`estimator'_2") ("unhandled") (_rc)
 14.         }
 15.     }
 16. }
