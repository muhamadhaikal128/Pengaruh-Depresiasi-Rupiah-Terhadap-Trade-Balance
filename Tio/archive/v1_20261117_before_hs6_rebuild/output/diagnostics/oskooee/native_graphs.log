. foreach id of local models {
  2.     import delimited "$OP/output/diagnostics/oskooee/dynamic_multipliers.c
> sv", clear varnames(1) case(preserve)
  3.     keep if model_id=="`id'"
  4.     twoway (rarea lower95_logpoints upper95_logpoints horizon_quarters if 
> direction=="depreciation", color(navy%15) lwidth(none)) (line effect_logpoint
> s horizon_quarters if direction=="depreciation", lcolor(navy)) (rarea lower95
> _logpoints upper95_logpoints horizon_quarters if direction=="appreciation", c
> olor(orange%15) lwidth(none)) (line effect_logpoints horizon_quarters if dire
> ction=="appreciation", lcolor(orange)), yline(0) title("`id'") subtitle("Dyna
> mic response to +/-ln(1.10) q shock") xtitle("Quarter") ytitle("100 x change 
> in ln(M/X)") legend(order(2 "Depreciation" 4 "Appreciation")) name(dm,replace
> ) nodraw
  5.     graph save dm "$OP/output/gph/oskooee/`id'_multipliers.gph", replace
  6.     import delimited "$OP/output/diagnostics/oskooee/stability_paths.csv",
>  clear varnames(1) case(preserve)
  7.     keep if model_id=="`id'"
  8.     format tq %tq
  9.     if _N>0 {
 10.         twoway (rarea lower upper tq, color(navy%15) lwidth(none)) (line C
> USUMSQ tq, lcolor(navy)) (line expected tq, lpattern(dash) lcolor(gs8)), titl
> e("`id': CUSUMSQ") subtitle("Gaussian-reference MC 95% band; 19,999 draws") l
> egend(order(2 "CUSUMSQ" 3 "Expected path")) name(sq,replace) nodraw
 11.         graph save sq "$OP/output/gph/oskooee/`id'_cusumsq.gph", replace
 12.     }
 13.     use "$OP/output/diagnostics/oskooee/models/`id'_design.dta", clear
 14.     format tq %tq
 15.     twoway line residual tq, yline(0) title("`id': residuals") name(re,rep
> lace) nodraw
 16.     graph save re "$OP/output/gph/oskooee/`id'_residuals.gph", replace
 17.     capture graph drop _all
 18. }
